# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set to true once the Google provider is configured in Supabase
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# n8n webhooks (leave empty for demo mode)
NEXT_PUBLIC_N8N_APPROVAL_WEBHOOK=
NEXT_PUBLIC_N8N_INTAKE_WEBHOOK=
